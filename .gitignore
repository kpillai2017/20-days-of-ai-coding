# This root file applies to every day, including nested project folders.

# Local environment configuration and secrets (keep examples shareable).
.direnv/
.envrc
.env
.env.*
!.env.example
!.env.*.example

# Python environments, bytecode and tool caches.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
*.egg-info/

# JavaScript dependencies and generated output.
# Lockfiles are NOT ignored: commit them if a future project adds dependencies.
node_modules/
dist/
build/

# Test reports and coverage artifacts.
coverage/
htmlcov/
.nyc_output/
.coverage
.coverage.*
coverage.xml
playwright-report/
test-results/

# Local logs and temporary development files.
*.log
.http-server-port
tmp_rovo_*

# Editors and operating-system metadata.
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

